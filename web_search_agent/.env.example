# Optional LLM API keys for research synthesis:
# If provided, Gemini or OpenAI/Groq is used to write an executive research report.
# If no key is set or quota is exceeded, the agent automatically falls back
# to the built-in deep summarization engine (zero API key needed!).

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI / Groq / OpenRouter / DeepSeek / Ollama (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
