# ASTRA 3.0 Environment Configuration

# Groq API Key (RECOMMENDED: 100% Free 14,400 req/day, ultra-fast 300 t/s, native tool-calling)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=

# Google Gemini API Key (Gemini 3.5 Flash / Flash-Lite / Pro)
GEMINI_API_KEY=

# Default Active Model
# Options: groq (llama-3.3-70b-versatile), gemini-3.5-flash-lite, gemini-3.5-flash, teja-gemma, ollama/qwen2.5-coder
ASTRA_MODEL=gemini-3.5-flash-lite

# Fine-Tuned TejaAI Colab/Kaggle GPU Model Server (Cloudflare Tunnel URL)
TEJA_MODEL_URL=

# Local Ollama URL (e.g. for local offline inference)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter / OpenAI / Anthropic Keys (Optional)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
