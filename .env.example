# ==============================================================================
# ASTRA-AGENT Configuration Template
# Copy this file to .env and configure keys as needed for your environment.
# ==============================================================================

# LLM Provider API Keys
# Groq: Check current model/project limits at https://console.groq.com
GROQ_API_KEY=

# Google Gemini: Gemini 2.5/3.5 models (https://aistudio.google.com)
GEMINI_API_KEY=

# Default Active Model
# Options:
#   - gemini-3.5-flash-lite
#   - gemini-3.5-flash
#   - openai/gpt-oss-120b
#   - qwen/qwen3.8-27b
#   - ollama/qwen2.5-coder:7b
ASTRA_MODEL=gemini-3.5-flash-lite

# Local Ollama Inference URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Fine-Tuned TejaAI GPU Server (Cloudflare Tunnel URL)
TEJA_MODEL_URL=

# Optional Provider Keys
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server & Security Controls
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8765

# API token for REST reads/writes and WebSockets (CLI server: optional on loopback)
ASTRA_API_TOKEN=

# Allowed CORS Origins (comma-separated, no wildcards in production)
ASTRA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8765,http://127.0.0.1:8765,app://-

# Execution Safeguards
ASTRA_MAX_ITERATIONS=30
ASTRA_COMMAND_TIMEOUT=120
ASTRA_PERMISSION_MODE=balanced
ASTRA_MAX_OUTPUT_CHARS=65536
ASTRA_CIRCUIT_BREAKER=true

# Authentication and fixed workspace trust roots (comma-separated absolute paths).
# The desktop starts an authenticated backend automatically.
ASTRA_REQUIRE_AUTH=false
ASTRA_ALLOWED_WORKSPACES=

# Local request caps, NOT Google account entitlements. Lower these to fit the
# active model limits shown in AI Studio. 0 disables an individual cap.
# The call cap is cumulative per session, including retries/fallback attempts.
ASTRA_MAX_LLM_CALLS_PER_TASK=20
ASTRA_GEMINI_RPM_BUDGET=5
ASTRA_GEMINI_RPD_BUDGET=50
# Use the same ID/data directory for every ASTRA process sharing a Google project.
ASTRA_GEMINI_PROJECT_ID=
# Deterministic classification is the default; enable the extra API call only if needed.
ASTRA_LLM_CLASSIFICATION=false
