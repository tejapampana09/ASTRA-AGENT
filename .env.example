# ==============================================================================
# ASTRA-AGENT Configuration Template
# Copy this file to .env and configure keys as needed for your environment.
# ==============================================================================

# LLM Provider API Keys
# Groq: Free 14,400 req/day, ultra-fast inference (https://console.groq.com)
GROQ_API_KEY=

# Google Gemini: Gemini 2.5/3.5 models (https://aistudio.google.com)
GEMINI_API_KEY=

# Default Active Model
# Options:
#   - gemini-3.5-flash-lite
#   - gemini-3.5-flash
#   - openai/gpt-oss-120b
#   - qwen/qwen3.8-27b
#   - ollama/qwen2.5-coder:7b
ASTRA_MODEL=gemini-3.5-flash-lite

# Local Ollama Inference URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Fine-Tuned TejaAI GPU Server (Cloudflare Tunnel URL)
TEJA_MODEL_URL=

# Optional Provider Keys
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server & Security Controls
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8765

# Optional Local API Token for mutating endpoints (leave empty for unauthenticated local loopback)
ASTRA_API_TOKEN=

# Allowed CORS Origins (comma-separated, no wildcards in production)
ASTRA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8765,http://127.0.0.1:8765,app://-

# Execution Safeguards
ASTRA_MAX_ITERATIONS=30
ASTRA_COMMAND_TIMEOUT=120
ASTRA_PERMISSION_MODE=balanced
ASTRA_MAX_OUTPUT_CHARS=65536
ASTRA_CIRCUIT_BREAKER=true
