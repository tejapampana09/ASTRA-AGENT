# ASTRA Configuration

# Google Gemini API Key (Recommended for high performance and speed)
GEMINI_API_KEY=

# Local Ollama base URL (e.g. for local qwen2.5-coder)
OLLAMA_BASE_URL=http://localhost:11434

# Fine-Tuned TejaAI Colab GPU Model Server (Optional Cloudflare Tunnel URL)
TEJA_MODEL_URL=

# Default Model (e.g. gemini-2.5-flash, gemini-2.5-pro, ollama/qwen2.5-coder, teja-gemma)
ASTRA_MODEL=gemini-2.5-flash

# OpenAI / Anthropic Keys (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
