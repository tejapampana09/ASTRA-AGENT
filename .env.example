# ==============================================================================
# ASTRA 2.0 Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="ASTRA 2.0 Autonomous Coding Agent"
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Persistence & Storage
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/astra_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/astra_db
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (LiteLLM / OpenHands compatible)
LLM_PROVIDER=litellm
LLM_MODEL=anthropic/claude-sonnet-4-5-20250929
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# Router Profiles
ROUTER_FAST_MODEL=openai/gpt-4o-mini
ROUTER_CODING_MODEL=anthropic/claude-sonnet-4-5-20250929
ROUTER_REASONING_MODEL=anthropic/claude-sonnet-4-5-20250929

# Execution & Orchestration Limits
MAX_ITERATIONS=15
MAX_TOOL_CALLS=50
MAX_RUNTIME_SECONDS=1800
MAX_RETRIES=3

# Workspace & Sandbox
WORKSPACE_BASE_DIR=./workspaces
ENABLE_DOCKER_SANDBOX=false
SANDBOX_CONTAINER_IMAGE=python:3.12-slim
COMMAND_TIMEOUT_SECONDS=180

# GitHub Integration
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# OpenHands Settings
OPENHANDS_SUPPRESS_BANNER=1

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=astra-2.0
